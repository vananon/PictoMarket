{
  "name": "pictomarket",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run && node --test tests/speech-controller.test.mjs",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "assets:pictograms": "node scripts/download-pictograms.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.{json,ts} index.html README.md public/ASSETS.md",
    "format:check": "prettier --check src tests scripts/*.mjs *.{json,ts} index.html README.md public/ASSETS.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
